{
  "name": "@hawkview/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild ./src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --packages=external --sourcemap",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:assign-owner": "node scripts/assign-organization-owner.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "test:tenant-health": "tsx --test src/tenants/tenant-health.test.ts",
    "test:service-sync-freshness": "tsx --test src/tenants/service-sync-freshness.test.ts",
    "test:collection-field-state": "tsx --test src/tenants/collection-field-state.test.ts",
    "test:changes": "tsx --test src/changes/change-evidence.service.test.ts",
    "test:m365-audit": "tsx --test src/tenants/m365-management-activity.test.ts",
    "test:auth-registrations": "tsx --test src/tenants/auth-registration-sync.test.ts",
    "test:sharepoint-contract": "tsx --test src/tenants/sharepoint-data-contract.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1126.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.4",
    "maxmind": "^5.0.7",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
