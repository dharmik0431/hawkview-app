# Local development connection through the Cloud SQL Auth Proxy.
# Copy this file to .env and replace the placeholders locally.
# Never commit the real password or connection string.
DATABASE_URL="postgresql://hawkview_app:REPLACE_WITH_PASSWORD@127.0.0.1:5433/hawkview?schema=public&connection_limit=2"
IDENTITY_PLATFORM_PROJECT_ID="hawkview-app"
PORT=8080
