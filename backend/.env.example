# PostgreSQL connection. Use a development database and keep the real value
# only in the backend hosting environment.
# Copy this file to .env and replace the placeholders locally.
# Never commit the real password or connection string.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@HOST:5432/postgres?schema=public&connection_limit=2"
SUPABASE_URL="https://REPLACE_WITH_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_APP_URL="http://localhost:3000"
GAS_PREVIEW_PROJECT_NUMBER=""

# Generate a long random value for portable scheduled-sync authentication.
# During migration, the existing Google OIDC settings can remain configured so
# either scheduler can authenticate. Remove them after the new scheduler works.
SCHEDULER_SHARED_SECRET="REPLACE_WITH_LONG_RANDOM_VALUE"
SCHEDULER_OIDC_AUDIENCE="http://localhost:8080/api/internal/sync/due-tenants"
SCHEDULER_SERVICE_ACCOUNT_EMAIL="hawkview-scheduler@hawkview-app.iam.gserviceaccount.com"
SCHEDULED_SYNC_BATCH_SIZE="10"
M365_AUDIT_POLL_INTERVAL_MINUTES="15"
M365_AUDIT_MAX_BLOBS_PER_RUN="12"
M365_AUDIT_MAX_DOWNLOAD_MB_PER_RUN="12"
M365_AUDIT_MAX_RUNTIME_SECONDS="45"
M365_AUDIT_TENANT_DAILY_DOWNLOAD_MB="50"
M365_AUDIT_DEPLOYMENT_DAILY_DOWNLOAD_MB="100"
M365_AUDIT_TENANT_MONTHLY_DOWNLOAD_MB="1000"
M365_AUDIT_DEPLOYMENT_MONTHLY_DOWNLOAD_MB="2000"
M365_AUDIT_TENANT_DAILY_RECORDS="1000"
M365_AUDIT_DEPLOYMENT_DAILY_RECORDS="2000"
M365_AUDIT_TENANT_MONTHLY_RECORDS="20000"
M365_AUDIT_DEPLOYMENT_MONTHLY_RECORDS="40000"

# GeoLite2 City MMDB used only when Microsoft does not expose sign-in locations
# for limited-license tenants. When the key is configured, the Render container
# downloads the current database to this path before starting the API.
GEOIP_CITY_DATABASE_PATH="/tmp/GeoLite2-City.mmdb"
MAXMIND_LICENSE_KEY="replace-with-maxmind-license-key"

# 32-byte master key used to encrypt application secrets before they are
# stored in PostgreSQL. Generate 64 hex characters, keep it outside the
# database, and never commit it. Losing this key makes stored secrets unreadable.
SECRET_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS"

# Non-secret Microsoft connector settings. Platform credentials are submitted
# once through HawkView and encrypted before they are stored in PostgreSQL.
MICROSOFT_ADMIN_CONSENT_REDIRECT_URI="http://localhost:8080/api/tenants/microsoft/admin-consent/callback"
MICROSOFT_REQUIRED_PERMISSIONS="Organization.Read.All,User.Read.All"
PORT=8080

# Optional authenticated post-deployment canary. Keep disabled until two
# synthetic, non-customer Supabase users each solely own one isolated HawkView
# organization containing exactly one pending, unconsented synthetic tenant.
# These values stay in
# the backend environment; GitHub receives only short-lived user access tokens
# after its exact main-branch workflow identity is verified through OIDC.
HAWKVIEW_CANARY_ENABLED="false"
HAWKVIEW_CANARY_A_AUTH_USER_ID="00000000-0000-4000-8000-000000000001"
HAWKVIEW_CANARY_A_EMAIL="canary-a@example.invalid"
HAWKVIEW_CANARY_A_ORGANIZATION_ID="00000000-0000-4000-8000-000000000002"
HAWKVIEW_CANARY_A_TENANT_ID="00000000-0000-4000-8000-000000000003"
HAWKVIEW_CANARY_B_AUTH_USER_ID="00000000-0000-4000-8000-000000000004"
HAWKVIEW_CANARY_B_EMAIL="canary-b@example.invalid"
HAWKVIEW_CANARY_B_ORGANIZATION_ID="00000000-0000-4000-8000-000000000005"
HAWKVIEW_CANARY_B_TENANT_ID="00000000-0000-4000-8000-000000000006"
