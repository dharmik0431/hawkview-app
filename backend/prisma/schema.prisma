  ipAddress               String?        @map("ip_address") @db.VarChar(64)
  clientAppUsed           String?        @map("client_app_used") @db.VarChar(100)
  conditionalAccessStatus String?        @map("conditional_access_status") @db.VarChar(50)
  isInteractive           Boolean?       @map("is_interactive")
  riskLevel               String?        @map("risk_level") @db.VarChar(50)
  statusErrorCode         String?        @map("status_error_code") @db.VarChar(32)
  failureReason           String?        @map("failure_reason") @db.Text
  location                Json?          @db.JsonB
  deviceDetail            Json?          @map("device_detail") @db.JsonB
  raw                     Json           @db.JsonB
  ingestedAt              DateTime       @default(now()) @map("ingested_at") @db.Timestamptz(6)
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz(6)
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
