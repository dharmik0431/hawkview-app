model IdentityRiskEvaluationRun {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  customerTenantId  String         @map("customer_tenant_id") @db.Uuid
  runKey            String         @map("run_key") @db.VarChar(128)
  engineVersion     String         @map("engine_version") @db.VarChar(100)
  catalogVersion    String         @map("catalog_version") @db.VarChar(100)
  status            String         @db.VarChar(30)
  windowStart       DateTime       @map("window_start") @db.Timestamptz(6)
  windowEnd         DateTime       @map("window_end") @db.Timestamptz(6)
  sourceWatermarkHash String       @map("source_watermark_hash") @db.VarChar(128)
  sourceContentHash   String       @map("source_content_hash") @db.VarChar(128)
  capability        String         @default("UNAVAILABLE") @db.VarChar(20)
  aggregate         Json           @default("{}") @db.JsonB
  /// NULL means no accounting was recorded — never the same as accounting that
  /// recorded zero. Deliberately has no default: a default would convert every
  /// pre-existing row into "assessed nothing, found nothing", permanently.
  evaluationCoverage Json?         @map("evaluation_coverage") @db.JsonB
  /// The findings a run produced, with each signal's own count, recency and
  /// ceiling. NULL means no findings record was written — never the same as a
  /// run that recorded an empty list. Deliberately has no default, for the same
  /// reason as evaluationCoverage: a default would convert every pre-existing
  /// row into "this run found nothing", permanently and undetectably.
  evaluationFindings Json?         @map("evaluation_findings") @db.JsonB
  alertDeliveryDisabled Boolean    @default(false) @map("alert_delivery_disabled")
  failureCode       String?        @map("failure_code") @db.VarChar(80)
  leaseToken        String?        @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime?      @map("lease_expires_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant    CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ruleCoverage      IdentityRiskRuleCoverage[]
  matchedResults    IdentityRiskMatchedResult[]
  pseudonymKeyVersionId String? @map("pseudonym_key_version_id") @db.Uuid
  sourceObservedAt DateTime? @map("source_observed_at") @db.Timestamptz(6)
  pseudonymKeyVersion IdentityRiskPseudonymKeyVersion? @relation(fields: [pseudonymKeyVersionId, organizationId, customerTenantId], references: [id, organizationId, customerTenantId], onDelete: NoAction)

  @@unique([organizationId, customerTenantId, runKey], map: "identity_risk_evaluation_runs_scope_key")
  @@unique([id, organizationId, customerTenantId], map: "identity_risk_evaluation_runs_scope_id")
  @@index([organizationId, customerTenantId, completedAt(sort: Desc)], map: "identity_risk_evaluation_runs_scope_completed")
  @@index([organizationId, customerTenantId, status, leaseExpiresAt], map: "identity_risk_evaluation_runs_scope_lease")
  @@index([expiresAt], map: "identity_risk_evaluation_runs_expiry")
  @@index([organizationId,customerTenantId,createdAt,id], map: "identity_risk_runs_history_scope")
  @@index([createdAt,id], map: "identity_risk_runs_history_scan")
  @@index([pseudonymKeyVersionId, organizationId, customerTenantId], map: "identity_risk_runs_key_version")
  @@map("identity_risk_evaluation_runs")
}

model IdentityRiskRuleCoverage {
  id                  String                    @id @default(uuid()) @db.Uuid
