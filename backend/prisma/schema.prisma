generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  STANDARD_USER
  PLATFORM_SUPPORT
  PLATFORM_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  MSP_OWNER
  MSP_ADMIN
  MSP_TECHNICIAN
  MSP_VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum CustomerTenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum TenantConnectionStatus {
  PENDING_CONSENT
  CONNECTED
  ERROR
  REVOKED
}

enum MicrosoftConnectionMode {
  HAWKVIEW_MANAGED
  CUSTOMER_MANAGED
}

enum SyncResourceType {
  USERS
  LICENSES
  ORGANIZATION_CONFIGURATION
  DOMAINS
  GROUPS
  AUTH_REGISTRATIONS
  AUTH_METHOD_POLICIES
  AUTHENTICATION_STRENGTHS
  CONDITIONAL_ACCESS
  NAMED_LOCATIONS
  SIGN_INS
  AUDIT_LOGS
  M365_AUDIT
  DEVICES
  DIRECTORY_ROLES
  SERVICE_PRINCIPALS
  APPLICATIONS
  SECURE_SCORES
  RISKY_USERS
  SECURITY_DEFAULTS
  SHAREPOINT_SITES
  SHAREPOINT_SETTINGS
  SHAREPOINT_USAGE
  EXCHANGE_MAILBOXES
  EXCHANGE_MAILBOX_SETTINGS
  EXCHANGE_MAILBOX_CONFIGURATION
  EXCHANGE_MAILBOX_USAGE
  EXCHANGE_ACCEPTED_DOMAINS
  EXCHANGE_MAILBOX_RULES
  DOMAIN_DNS_HEALTH
}

enum SyncStateStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum MicrosoftConsentFlow {
  DISCOVER_TENANT
  EXISTING_TENANT
  EXCHANGE_READ_ONLY
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  authProviderUserId String?        @unique @map("auth_provider_user_id") @db.VarChar(128)
  email              String         @unique @db.VarChar(320)
  displayName        String?        @map("display_name") @db.VarChar(200)
  timeZone           String?        @map("time_zone") @db.VarChar(100)
  dateFormat         String         @default("MM/DD/YYYY") @map("date_format") @db.VarChar(20)
  timeFormat         String         @default("12h") @map("time_format") @db.VarChar(3)
  platformRole       PlatformRole   @default(STANDARD_USER) @map("platform_role")
  disabledAt         DateTime?      @map("disabled_at") @db.Timestamptz(6)
  inviteSentAt       DateTime?      @map("invite_sent_at") @db.Timestamptz(6)
  inviteAcceptedAt   DateTime?      @map("invite_accepted_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  notificationStates NotificationUserState[]
  notificationPreferences NotificationPreference[]
  foundedOrganizations Organization[] @relation("OrganizationFounder")
  microsoftConsentAttempts MicrosoftConsentAttempt[]

  @@index([platformRole])
  @@index([disabledAt])
  @@map("users")
}

model Notification {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  customerTenantId  String?                 @map("customer_tenant_id") @db.Uuid
  recipientUserId   String?                 @map("recipient_user_id") @db.Uuid
  eventType         String                  @map("event_type") @db.VarChar(80)
  category          String                  @db.VarChar(20)
  severity          String                  @default("info") @db.VarChar(20)
  title             String                  @db.VarChar(200)
  description       String                  @db.VarChar(1000)
  metadata          Json?
  actionUrl         String?                 @map("action_url") @db.VarChar(500)
  actionLabel       String?                 @map("action_label") @db.VarChar(100)
  source            String                  @default("system") @db.VarChar(80)
  dedupeKey         String                  @map("dedupe_key") @db.VarChar(300)
  occurrenceCount   Int                     @default(1) @map("occurrence_count")
  firstOccurredAt   DateTime                @default(now()) @map("first_occurred_at") @db.Timestamptz(6)
  lastOccurredAt    DateTime                @default(now()) @map("last_occurred_at") @db.Timestamptz(6)
  resolvedAt        DateTime?               @map("resolved_at") @db.Timestamptz(6)
  expiresAt         DateTime?               @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// The incident this row belongs to. NULL until step 03 keys it, and NULL again after a
  /// revert. Many rows share one key: the unique constraint below forbids them sharing a
  /// dedupe key, so consolidation is a column rather than fewer rows.
  ///
  /// IN THE SCHEMA RATHER THAN ONLY IN THE MIGRATION, which was a ruling. A column absent
  /// from the schema is invisible to every consumer except a raw query — so routing, and
  /// anything that reads incidents, could not see the key at all, and the point of the
  /// migration is that many rows share one.
  /// WHICH ALERT TYPE THIS IS, AND IT IS THE FACT. The urgency tier is DERIVED from it through
  /// `ALERT_CATALOG`, never stored a second time — two columns describing how urgent something
  /// is disagree the first time anybody edits one. `severity` below is still set, derived from
  /// this at write time, because the reader's visibility filter matches on it: it is a
  /// RENDERING, and this column wins if they ever disagree.
  ///
  /// NULL FOR EVERY NOTIFICATION THAT IS NOT AN ALERT, and absence is not a tier. A row that did
  /// not say is not RECORD_ONLY — that is a decision somebody made to stop being told.
  alertTypeId       String?                 @map("alert_type_id") @db.VarChar(64)
  incidentKey       String?                 @map("incident_key") @db.VarChar(400)
  /// Which burst within the incident. NULL where the count could not be recovered, which is
  /// a VALUE and not an absence: it means the incident holds a row whose event time is gone.
  /// Distinguishable from episode 1, deliberately.
  episode           Int?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant    CustomerTenant?         @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  states            NotificationUserState[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, lastOccurredAt(sort: Desc)])
  @@index([customerTenantId, resolvedAt])
  /// Organisation first: the column exists to be grouped by, every read here is org-scoped,
  /// and an incident key never spans two organisations. See the migration for why this is
  /// not a partial index.
  @@index([organizationId, incidentKey])
  @@index([organizationId, alertTypeId])
  @@map("notifications")
}

model NotificationUserState {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime?    @map("dismissed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, dismissedAt])
  @@map("notification_user_states")
}

model NotificationPreference {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @map("user_id") @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  securityEnabled        Boolean      @default(true) @map("security_enabled")
  connectionEnabled      Boolean      @default(true) @map("connection_enabled")
  synchronizationEnabled Boolean      @default(true) @map("synchronization_enabled")
  accountEnabled         Boolean      @default(true) @map("account_enabled")
  inAppEnabled           Boolean      @default(true) @map("in_app_enabled")
  minimumSeverity        String       @default("info") @map("minimum_severity") @db.VarChar(20)
  emailEnabled           Boolean      @default(false) @map("email_enabled")
  digestMode             String       @default("off") @map("digest_mode") @db.VarChar(20)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("notification_preferences")
}

/// THE LIFECYCLE OF AN INCIDENT, once per incident.
///
/// A PROJECTION OVER `notifications`, NOT A PARENT OF THEM. An incident is the set of rows
/// sharing an `incident_key`; this holds the state of that set. There is deliberately no
/// relation to `Notification`: nothing cascades either way, and an incident row missing for a
/// keyed notification is a REPORTABLE GAP rather than a broken foreign key.
///
/// WHY NOT COLUMNS ON `notifications`: an incident spans many rows, so the state would be
/// stored once per row with nothing making the copies agree. Acknowledging would be N writes,
/// and a partial failure leaves an incident half-acknowledged with no way to tell.
///
/// WHY NOT ON `IdentityRiskFinding`: half the incidents have no finding. Step 03 migrates rows
/// produced by tenant sync and directory audit, which never had one.
model AlertIncident {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  /// Matches `notifications.incident_key`. Same width, for the same reason.
  incidentKey     String   @map("incident_key") @db.VarChar(400)
  /// Which catalogue type this incident is, so the lifecycle rules that depend on category
  /// (an OPERATIONAL investigation may be closed by the system; a SECURITY one may not) can be
  /// applied without re-deriving the type from the key.
  alertTypeId     String   @map("alert_type_id") @db.VarChar(80)
  /// UNACKNOWLEDGED | ACKNOWLEDGED
  ownership       String   @db.VarChar(20)
  /// ACTIVE | CLEARED | UNKNOWN
  condition       String   @db.VarChar(20)
  /// OPEN | RESOLVED | NONE
  investigation   String   @db.VarChar(20)
  /// THREE TIMESTAMPS, ONE PER AXIS, and that is the point of three axes.
  ///
  /// A single `updatedAt` would collapse "when did the condition last change" and "when was
  /// this acknowledged" into one fact, and those move independently — a cleared condition on an
  /// unacknowledged incident is a normal state. Collapsing them is the failure this feature has
  /// found in four other places.
  ownershipAt     DateTime @map("ownership_at") @db.Timestamptz(6)
  conditionAt     DateTime @map("condition_at") @db.Timestamptz(6)
  investigationAt DateTime @map("investigation_at") @db.Timestamptz(6)
  /// Who acknowledged it. Constrained in SQL to be present exactly when ownership is
  /// ACKNOWLEDGED — see the migration. Two fields that can disagree need one owner, and here
  /// the database is it.
  acknowledgedBy  String?  @map("acknowledged_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, incidentKey])
  /// The queue read: this MSP’s incidents that still need somebody.
  @@index([organizationId, ownership, conditionAt(sort: Desc)])
  @@map("alert_incidents")
}

/// WHAT AN MSP CONSIDERS URGENT, per rule. ORGANISATION GRAIN, deliberately.
///
/// TWO GRAINS, TWO QUESTIONS, AND THEY HOLD DIFFERENT FACTS. This answers *what counts as
/// urgent here*, which is an MSP policy — two people in one MSP must not disagree about whether
/// a privileged role grant is urgent. How and when a given person hears about it is a separate
/// fact and lives on `NotificationPreference`, at the user grain.
///
/// Two places holding the SAME fact is the defect this feature has fixed three times. Two
/// places holding DIFFERENT facts is just a system: the organisation says a role grant is
/// urgent, a user says do not email me, and both are honoured.
///
/// A ROW EXISTS ONLY WHERE AN MSP HAS OVERRIDDEN THE DEFAULT. Nothing is seeded, and that is
/// forced rather than lazy: `defaultPreferenceFor` derives the default FROM THE DECLARED
/// SEVERITY, precisely "so the default cannot drift from the tiering the catalogue already
/// states". Seeding twenty rows per organisation would copy a derived value into storage, and
/// the copies would disagree with the catalogue the first time a severity changed.
model AlertRuleDisposition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// **AN ALERT TYPE ID, because that is what the pipeline looks it up by.** This was called
  /// `ruleId` and the name lied: a disposition stored as a rule id was silently ignored and the
  /// email went anyway — the row existed, the write succeeded, the MSP saw their choice saved.
  /// The key is now built by `dispositionKey()`, which only accepts an `AlertTypeId`, so the
  /// confusion is a compile error rather than a naming convention.
  ///
  /// A FINER GRAIN THAN THE ALERT TYPE WOULD NEED ITS OWN COLUMN AND A DISCRIMINATOR, not this
  /// one holding two kinds of id. Five of the seven types use the type as their own grain today.
  alertTypeId    String   @map("alert_type_id") @db.VarChar(120)
  /// ACT_NOW | ACT_TODAY | RECORD_ONLY — the catalogue's `Severity`, constrained in SQL.
  /// **THE TIER, NOT THE CHANNEL**: the organisation answers what counts as urgent here, and the
  /// product decides how to reach them about something that urgent. There is still no OFF — an
  /// MSP may choose not to be DELIVERED to, never to have the thing not recorded.
  disposition    String   @db.VarChar(20)
  /// Who set it and when, because a preference nobody can attribute is one nobody will change.
  setByUserId    String?  @map("set_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alertTypeId])
  @@map("alert_rule_dispositions")
}

/// One send, with its own budget. See `send-queue.ts`.
///
/// THE BUDGET IS A FACT ON THE ROW. `attemptsMade`/`maxAttempts` are columns because a
/// runner-scoped counter restarts at zero on a redeploy or a second worker, and the job then
/// retries forever while every test of the runner shows it stopping.
///
/// NO TENANT AND NO ORGANISATION COLUMN: a per-tenant queue is unwriteable rather than
/// discouraged, because there is no field to partition on.
model AlertSendJob {
  id             String    @id @default(uuid()) @db.Uuid
  messageId      String    @unique @map("message_id") @db.VarChar(400)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(400)
  /// READY | CLAIMED | SENT | EXHAUSTED | GAVE_UP | CANCELLED — constrained in SQL, see the
  /// migration. CANCELLED is the operator stop; it is terminal and cannot be claimed again.
  state          String    @db.VarChar(20)
  attemptsMade   Int       @map("attempts_made")
  maxAttempts    Int       @map("max_attempts")
  /// The backoff, as a fact rather than a sleeping worker.
  notBeforeAt    DateTime  @map("not_before_at") @db.Timestamptz(6)
  claimedBy      String?   @map("claimed_by") @db.VarChar(100)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(6)
  providerId     String?   @map("provider_id") @db.VarChar(200)
  /// WHO STOPPED IT, WHEN AND WHY. Six months from now "why was this MSP never told" has to be
  /// answerable from the record; the state alone says somebody stopped it and nothing says who.
  /// All three or none, enforced by a CHECK — see the migration.
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy      String?   @map("cancelled_by") @db.VarChar(200)
  cancelledBecause String?   @map("cancelled_because") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, notBeforeAt])
  @@index([cancelledAt])
  @@map("alert_send_jobs")
}

/// One attempt. WRITTEN BEFORE THE SEND, which is why the settlement is nullable: an attempt
/// recorded on return leaves no trace when a process dies mid-send, and the retry then sends a
/// second email believing it is the first.
///
/// No foreign key to the job: an attempt is evidence and must survive the job being removed.
model AlertSendAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.VarChar(400)
  attemptNo   Int       @map("attempt_no")
  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  /// ACCEPTED | REFUSED_RETRYABLE | REFUSED_PERMANENT, or null while in flight.
  settledKind String?   @map("settled_kind") @db.VarChar(30)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(6)
  providerId  String?   @map("provider_id") @db.VarChar(200)
  because     String?   @db.VarChar(500)

  @@unique([messageId, attemptNo])
  @@index([settledKind, startedAt])
  @@map("alert_send_attempts")
}

/// AN ADDRESS THAT MUST NOT BE WRITTEN TO AGAIN. A hard bounce is a fact about an address, not
/// an error in a log — the mail server has said the mailbox does not exist, and continuing to
/// attempt it is what earns a sending domain a reputation problem. The damage lands on every
/// other message HawkView sends, not on the one that bounced.
///
/// THE ADDRESS IS THE PRIMARY KEY, not a surrogate id. A uuid key permits two rows disagreeing
/// about one address, and then "is this suppressed" has two answers and no owner.
///
/// NO ORGANISATION COLUMN, deliberately, and it is the uncomfortable direction: a mailbox proven
/// dead by one MSP's send is dead for all of them, because the fact is about the mailbox. Scoping
/// it per organisation would let a second organisation re-prove the same dead address and take
/// the same reputation hit to learn what was already known.
///
/// NO EXPIRY, AND NO UNSUPPRESS PATH YET. A hard bounce does not heal on a timer, so a TTL would
/// be a guess that resumes sending to a dead mailbox on a schedule. Removing one is a deliberate
/// act; that it currently requires SQL is flagged in the handoff rather than hidden.
model AlertSuppressedAddress {
  address           String   @id @db.VarChar(320)
  /// HARD_BOUNCE | COMPLAINT | MANUAL — constrained in SQL, see the migration.
  reason            String   @db.VarChar(30)
  /// What the provider said, kept verbatim so a wrong suppression can be argued with.
  because           String?  @db.VarChar(500)
  /// The message that proved it. Null for MANUAL, which has no send behind it.
  messageId         String?  @map("message_id") @db.VarChar(400)
  firstSuppressedAt DateTime @map("first_suppressed_at") @db.Timestamptz(6)
  lastSeenAt        DateTime @map("last_seen_at") @db.Timestamptz(6)

  @@index([reason, firstSuppressedAt])
  @@map("alert_suppressed_addresses")
}

model Organization {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String                     @db.VarChar(200)
  slug               String                     @unique @db.VarChar(100)
  businessDomain     String?                    @map("business_domain") @db.VarChar(253)
  timeZone           String?                    @map("time_zone") @db.VarChar(100)
  alertIncidents     AlertIncident[]
  alertRuleDispositions AlertRuleDisposition[]
  onboardingCompletedAt DateTime?               @map("onboarding_completed_at") @db.Timestamptz(6)
  createdByUserId    String?                    @map("created_by_user_id") @db.Uuid
  status             OrganizationStatus         @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  customerTenants    CustomerTenant[]
  directoryUsers     DirectoryUser[]
  directoryGroups    DirectoryGroup[]
  groupMemberships   DirectoryGroupMembership[]
  tenantLicenses     TenantLicense[]
  tenantDomains      TenantDomain[]
  syncStates         SyncState[]
  collectionFieldStates TenantCollectionFieldState[]
  entraSnapshots     TenantEntraSnapshot[]
  signInLogs         SignInLog[]
  directoryAuditLogs DirectoryAuditLog[]
  m365ActivitySubscriptions M365ActivitySubscription[]
  m365ActivityContents M365ActivityContent[]
  m365AuditRecords M365AuditRecord[]
  m365AuditDailyUsage M365AuditDailyUsage[]
  changeEvidenceEvents ChangeEvidenceEvent[]
  identityRiskEvaluationRuns IdentityRiskEvaluationRun[]
  identityRiskPseudonymKeys IdentityRiskPseudonymKeyVersion[]
  identityRiskRuleCoverage IdentityRiskRuleCoverage[]
  identityRiskMatchedResults IdentityRiskMatchedResult[]
  identityRiskFindings IdentityRiskFinding[]
  identityRiskOperationalControls IdentityRiskOperationalControl[]
  healthSnapshots      TenantHealthSnapshot[]
  notifications      Notification[]
  microsoftConsentAttempts MicrosoftConsentAttempt[]
  notificationPreferences NotificationPreference[]
  createdBy          User?                      @relation("OrganizationFounder", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdByUserId])
  @@index([onboardingCompletedAt])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, status])
  @@map("memberships")
}

/// THE NAME IS NARROWER THAN THE CONTENTS, AND THAT IS A KNOWN, ACCEPTED WART.
///
/// This table no longer holds only workspace-admin actions. It also records
/// CUSTOMER_IDENTITY_DISCLOSED — that an operator was shown identifying
/// information about a customer's users — because a second audit table would
/// mean a second retention implementation, and two retention implementations is
/// a worse failure than one misnamed table: the second one stops silently and
/// nobody notices for a year. Retention, pruning and the isolation tests behind
/// this table are already proven, so reads live here.
///
/// A name that makes a claim about its contents is the fault this codebase has
/// hit repeatedly, so it is written down rather than left to mislead. Renaming a
/// live table other code queries is the larger risk; a rename is a separate,
/// optional cleanup. See docs/identity-disclosure-audit.md.
model WorkspaceAdminAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorEmail    String?  @map("actor_email") @db.VarChar(320)
  targetUserId  String?  @map("target_user_id") @db.Uuid
  targetEmail   String?  @map("target_email") @db.VarChar(320)
  targetType     String?   @map("target_type") @db.VarChar(50)
  targetOpaqueId String?   @map("target_opaque_id") @db.VarChar(128)
  action        String   @db.VarChar(100)
  outcome       String   @default("SUCCEEDED") @db.VarChar(30)
  stage          String?   @db.VarChar(50)
  errorCode      String?   @map("error_code") @db.VarChar(100)
  requestId      String?   @map("request_id") @db.VarChar(100)
  operationId    String?   @map("operation_id") @db.Uuid
  eventVersion   Int       @default(1) @map("event_version")
  metadata      Json?
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([organizationId, operationId, createdAt])
  @@index([organizationId, requestId, createdAt])
  @@index([expiresAt])
  @@map("workspace_admin_audit_logs")
}

model CustomerTenant {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @map("organization_id") @db.Uuid
  microsoftTenantId  String                     @unique @map("microsoft_tenant_id") @db.Uuid
  displayName        String?                    @map("display_name") @db.VarChar(200)
  primaryDomain      String?                    @map("primary_domain") @db.VarChar(253)
  status             CustomerTenantStatus       @default(PENDING)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection         TenantConnection?
  directoryUsers     DirectoryUser[]
  directoryGroups    DirectoryGroup[]
  groupMemberships   DirectoryGroupMembership[]
