generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  STANDARD_USER
  PLATFORM_SUPPORT
  PLATFORM_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  MSP_OWNER
  MSP_ADMIN
  MSP_TECHNICIAN
  MSP_VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum CustomerTenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum TenantConnectionStatus {
  PENDING_CONSENT
  CONNECTED
  ERROR
  REVOKED
}

enum MicrosoftConnectionMode {
  HAWKVIEW_MANAGED
  CUSTOMER_MANAGED
}

enum SyncResourceType {
  USERS
  LICENSES
  DOMAINS
  GROUPS
  AUTH_REGISTRATIONS
  AUTH_METHOD_POLICIES
  CONDITIONAL_ACCESS
  NAMED_LOCATIONS
  SIGN_INS
  AUDIT_LOGS
  DEVICES
  DIRECTORY_ROLES
  SERVICE_PRINCIPALS
  APPLICATIONS
  SECURITY_DEFAULTS
  SHAREPOINT_SITES
  SHAREPOINT_SETTINGS
  SHAREPOINT_USAGE
  EXCHANGE_MAILBOXES
  EXCHANGE_MAILBOX_CONFIGURATION
  EXCHANGE_MAILBOX_USAGE
  EXCHANGE_ACCEPTED_DOMAINS
  EXCHANGE_MAILBOX_RULES
  DOMAIN_DNS_HEALTH
}

enum SyncStateStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  authProviderUserId String?        @unique @map("auth_provider_user_id") @db.VarChar(128)
  email              String         @unique @db.VarChar(320)
  displayName        String?        @map("display_name") @db.VarChar(200)
  timeZone           String?        @map("time_zone") @db.VarChar(100)
  dateFormat         String         @default("MM/DD/YYYY") @map("date_format") @db.VarChar(20)
  timeFormat         String         @default("12h") @map("time_format") @db.VarChar(3)
  platformRole       PlatformRole   @default(STANDARD_USER) @map("platform_role")
  disabledAt         DateTime?      @map("disabled_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  notificationStates NotificationUserState[]
  notificationPreferences NotificationPreference[]

  @@index([platformRole])
  @@index([disabledAt])
  @@map("users")
}

model Notification {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  customerTenantId  String?                 @map("customer_tenant_id") @db.Uuid
  recipientUserId   String?                 @map("recipient_user_id") @db.Uuid
  eventType         String                  @map("event_type") @db.VarChar(80)
  category          String                  @db.VarChar(20)
  severity          String                  @default("info") @db.VarChar(20)
  title             String                  @db.VarChar(200)
  description       String                  @db.VarChar(1000)
  metadata          Json?
  actionUrl         String?                 @map("action_url") @db.VarChar(500)
  actionLabel       String?                 @map("action_label") @db.VarChar(100)
  source            String                  @default("system") @db.VarChar(80)
  dedupeKey         String                  @map("dedupe_key") @db.VarChar(300)
  occurrenceCount   Int                     @default(1) @map("occurrence_count")
  firstOccurredAt   DateTime                @default(now()) @map("first_occurred_at") @db.Timestamptz(6)
  lastOccurredAt    DateTime                @default(now()) @map("last_occurred_at") @db.Timestamptz(6)
  resolvedAt        DateTime?               @map("resolved_at") @db.Timestamptz(6)
  expiresAt         DateTime?               @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant    CustomerTenant?         @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  states            NotificationUserState[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, lastOccurredAt(sort: Desc)])
  @@index([customerTenantId, resolvedAt])
  @@map("notifications")
}

model NotificationUserState {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime?    @map("dismissed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, dismissedAt])
  @@map("notification_user_states")
}

model NotificationPreference {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @map("user_id") @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  securityEnabled        Boolean      @default(true) @map("security_enabled")
  connectionEnabled      Boolean      @default(true) @map("connection_enabled")
  synchronizationEnabled Boolean      @default(true) @map("synchronization_enabled")
  accountEnabled         Boolean      @default(true) @map("account_enabled")
  inAppEnabled           Boolean      @default(true) @map("in_app_enabled")
  minimumSeverity        String       @default("info") @map("minimum_severity") @db.VarChar(20)
  emailEnabled           Boolean      @default(false) @map("email_enabled")
  digestMode             String       @default("off") @map("digest_mode") @db.VarChar(20)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("notification_preferences")
}

model Organization {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String                     @db.VarChar(200)
  slug               String                     @unique @db.VarChar(100)
  status             OrganizationStatus         @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  customerTenants    CustomerTenant[]
  directoryUsers     DirectoryUser[]
  directoryGroups    DirectoryGroup[]
  groupMemberships   DirectoryGroupMembership[]
  tenantLicenses     TenantLicense[]
  tenantDomains      TenantDomain[]
  syncStates         SyncState[]
  entraSnapshots     TenantEntraSnapshot[]
  signInLogs         SignInLog[]
  directoryAuditLogs DirectoryAuditLog[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]

  @@index([status])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, status])
  @@map("memberships")
}

model CustomerTenant {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @map("organization_id") @db.Uuid
  microsoftTenantId  String                     @unique @map("microsoft_tenant_id") @db.Uuid
  displayName        String?                    @map("display_name") @db.VarChar(200)
  primaryDomain      String?                    @map("primary_domain") @db.VarChar(253)
  status             CustomerTenantStatus       @default(PENDING)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection         TenantConnection?
  directoryUsers     DirectoryUser[]
  directoryGroups    DirectoryGroup[]
  groupMemberships   DirectoryGroupMembership[]
  tenantLicenses     TenantLicense[]
  tenantDomains      TenantDomain[]
  syncStates         SyncState[]
  entraSnapshots     TenantEntraSnapshot[]
  signInLogs         SignInLog[]
  directoryAuditLogs DirectoryAuditLog[]
  notifications      Notification[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("customer_tenants")
}

model DirectoryUser {
  id                    String                     @id @default(uuid()) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  customerTenantId      String                     @map("customer_tenant_id") @db.Uuid
  microsoftUserId       String                     @map("microsoft_user_id") @db.Uuid
  displayName           String                     @map("display_name") @db.VarChar(256)
  userPrincipalName     String                     @map("user_principal_name") @db.VarChar(320)
  mail                  String?                    @db.VarChar(320)
  accountEnabled        Boolean                    @default(true) @map("account_enabled")
  userType              String?                    @map("user_type") @db.VarChar(50)
  assignedLicenseSkuIds String[]                   @default([]) @map("assigned_license_sku_ids")
  firstSeenAt           DateTime                   @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt            DateTime                   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  deletedAt             DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant        CustomerTenant             @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  groupMemberships      DirectoryGroupMembership[]

  @@unique([customerTenantId, microsoftUserId])
  @@unique([id, customerTenantId, organizationId])
  @@index([organizationId, customerTenantId, deletedAt])
  @@index([customerTenantId, userPrincipalName])
  @@map("directory_users")
}

model DirectoryGroup {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  customerTenantId String                     @map("customer_tenant_id") @db.Uuid
  microsoftGroupId String                     @map("microsoft_group_id") @db.Uuid
  displayName      String                     @map("display_name") @db.VarChar(256)
  description      String?                    @db.Text
  mail             String?                    @db.VarChar(320)
  mailNickname     String?                    @map("mail_nickname") @db.VarChar(256)
  mailEnabled      Boolean                    @default(false) @map("mail_enabled")
  securityEnabled  Boolean                    @default(false) @map("security_enabled")
  groupTypes       String[]                   @default([]) @map("group_types")
  visibility       String?                    @db.VarChar(50)
  firstSeenAt      DateTime                   @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime                   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant   CustomerTenant             @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  memberships      DirectoryGroupMembership[]

  @@unique([customerTenantId, microsoftGroupId])
  @@unique([id, customerTenantId, organizationId])
  @@index([organizationId, customerTenantId])
  @@index([customerTenantId, displayName])
  @@map("directory_groups")
}

model DirectoryGroupMembership {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  customerTenantId String         @map("customer_tenant_id") @db.Uuid
  directoryGroupId String         @map("directory_group_id") @db.Uuid
  directoryUserId  String         @map("directory_user_id") @db.Uuid
  firstSeenAt      DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant   CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  directoryGroup   DirectoryGroup @relation(fields: [directoryGroupId, customerTenantId, organizationId], references: [id, customerTenantId, organizationId], onDelete: Cascade)
  directoryUser    DirectoryUser  @relation(fields: [directoryUserId, customerTenantId, organizationId], references: [id, customerTenantId, organizationId], onDelete: Cascade)

  @@unique([directoryGroupId, directoryUserId])
  @@index([organizationId, customerTenantId])
  @@index([customerTenantId, directoryUserId])
  @@map("directory_group_memberships")
}

model TenantLicense {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  customerTenantId String         @map("customer_tenant_id") @db.Uuid
  microsoftSkuId   String         @map("microsoft_sku_id") @db.Uuid
  skuPartNumber    String         @map("sku_part_number") @db.VarChar(200)
  consumedUnits    Int            @default(0) @map("consumed_units")
  enabledUnits     Int            @default(0) @map("enabled_units")
  warningUnits     Int            @default(0) @map("warning_units")
  suspendedUnits   Int            @default(0) @map("suspended_units")
  lockedOutUnits   Int            @default(0) @map("locked_out_units")
  capabilityStatus String?        @map("capability_status") @db.VarChar(50)
  firstSeenAt      DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant   CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, microsoftSkuId])
  @@index([organizationId, customerTenantId])
  @@map("tenant_licenses")
}

model TenantDomain {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  customerTenantId String         @map("customer_tenant_id") @db.Uuid
  name             String         @db.VarChar(253)
  isDefault        Boolean        @default(false) @map("is_default")
  isInitial        Boolean        @default(false) @map("is_initial")
  firstSeenAt      DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant   CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, name])
  @@index([organizationId, customerTenantId])
  @@map("tenant_domains")
}

model SyncState {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  customerTenantId    String           @map("customer_tenant_id") @db.Uuid
  resourceType        SyncResourceType @map("resource_type")
  status              SyncStateStatus  @default(IDLE)
  deltaLink           String?          @map("delta_link") @db.Text
  lastAttemptAt       DateTime?        @map("last_attempt_at") @db.Timestamptz(6)
  lastSuccessfulAt    DateTime?        @map("last_successful_at") @db.Timestamptz(6)
  lastErrorCode       String?          @map("last_error_code") @db.VarChar(100)
  lastErrorMessage    String?          @map("last_error_message") @db.Text
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant      CustomerTenant   @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, resourceType])
  @@index([organizationId, status])
  @@map("sync_states")
}

model TenantEntraSnapshot {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  customerTenantId String           @map("customer_tenant_id") @db.Uuid
  resourceType     SyncResourceType @map("resource_type")
  payload          Json             @default("[]") @db.JsonB
  observedAt       DateTime         @default(now()) @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant   CustomerTenant   @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, resourceType])
  @@index([organizationId, customerTenantId])
  @@map("tenant_entra_snapshots")
}

model SignInLog {
  id                      String         @id @default(uuid()) @db.Uuid
  organizationId          String         @map("organization_id") @db.Uuid
  customerTenantId        String         @map("customer_tenant_id") @db.Uuid
  microsoftSignInId       String         @map("microsoft_sign_in_id") @db.VarChar(200)
  eventDateTime           DateTime       @map("event_date_time") @db.Timestamptz(6)
  userId                  String?        @map("user_id") @db.VarChar(128)
  userDisplayName         String?        @map("user_display_name") @db.VarChar(256)
  userPrincipalName       String?        @map("user_principal_name") @db.VarChar(320)
  appId                   String?        @map("app_id") @db.VarChar(128)
  appDisplayName          String?        @map("app_display_name") @db.VarChar(256)
  resourceDisplayName     String?        @map("resource_display_name") @db.VarChar(256)
  ipAddress               String?        @map("ip_address") @db.VarChar(64)
  clientAppUsed           String?        @map("client_app_used") @db.VarChar(100)
  conditionalAccessStatus String?        @map("conditional_access_status") @db.VarChar(50)
  isInteractive           Boolean?       @map("is_interactive")
  riskLevel               String?        @map("risk_level") @db.VarChar(50)
  statusErrorCode         String?        @map("status_error_code") @db.VarChar(32)
  failureReason           String?        @map("failure_reason") @db.Text
  location                Json?          @db.JsonB
  deviceDetail            Json?          @map("device_detail") @db.JsonB
  raw                     Json           @db.JsonB
  ingestedAt              DateTime       @default(now()) @map("ingested_at") @db.Timestamptz(6)
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz(6)
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant          CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, microsoftSignInId])
  @@index([organizationId, customerTenantId, eventDateTime(sort: Desc)])
  @@index([customerTenantId, userPrincipalName, eventDateTime(sort: Desc)])
  @@index([expiresAt])
  @@map("sign_in_logs")
}

model DirectoryAuditLog {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  customerTenantId    String         @map("customer_tenant_id") @db.Uuid
  microsoftAuditId    String         @map("microsoft_audit_id") @db.VarChar(200)
  eventDateTime       DateTime       @map("event_date_time") @db.Timestamptz(6)
  activityDisplayName String         @map("activity_display_name") @db.VarChar(500)
  category            String?        @db.VarChar(100)
  operationType       String?        @map("operation_type") @db.VarChar(100)
  result              String?        @db.VarChar(50)
  resultReason        String?        @map("result_reason") @db.Text
  correlationId       String?        @map("correlation_id") @db.VarChar(128)
  loggedByService     String?        @map("logged_by_service") @db.VarChar(100)
  initiatedBy         Json?          @map("initiated_by") @db.JsonB
  targetResources     Json?          @map("target_resources") @db.JsonB
  additionalDetails   Json?          @map("additional_details") @db.JsonB
  raw                 Json           @db.JsonB
  ingestedAt          DateTime       @default(now()) @map("ingested_at") @db.Timestamptz(6)
  expiresAt           DateTime       @map("expires_at") @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTenant      CustomerTenant @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, microsoftAuditId])
  @@index([organizationId, customerTenantId, eventDateTime(sort: Desc)])
  @@index([customerTenantId, category, eventDateTime(sort: Desc)])
  @@index([expiresAt])
  @@map("directory_audit_logs")
}

model TenantConnection {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  customerTenantId      String                  @map("customer_tenant_id") @db.Uuid
  status                TenantConnectionStatus  @default(PENDING_CONSENT)
  connectionMode        MicrosoftConnectionMode @default(HAWKVIEW_MANAGED) @map("connection_mode")
  clientId              String?                 @map("client_id") @db.Uuid
  credentialReference   String?                 @map("credential_reference") @db.VarChar(500)
  credentialExpiresAt   DateTime?               @map("credential_expires_at") @db.Timestamptz(6)
  consentedPermissions  String[]                @default([]) @map("consented_permissions")
  consentedAt           DateTime?               @map("consented_at") @db.Timestamptz(6)
  consentStateHash      String?                 @map("consent_state_hash") @db.VarChar(64)
  consentStateExpiresAt DateTime?               @map("consent_state_expires_at") @db.Timestamptz(6)
  lastVerifiedAt        DateTime?               @map("last_verified_at") @db.Timestamptz(6)
  lastErrorCode         String?                 @map("last_error_code") @db.VarChar(100)
  lastErrorMessage      String?                 @map("last_error_message") @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerTenant        CustomerTenant          @relation(fields: [customerTenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerTenantId, organizationId])
  @@index([organizationId, status])
  @@map("tenant_connections")
}

model PlatformMicrosoftConnector {
  id                  String    @id @default("default") @db.VarChar(32)
  clientId            String    @map("client_id") @db.Uuid
  homeTenantId        String    @map("home_tenant_id") @db.Uuid
  credentialReference String    @map("credential_reference") @db.VarChar(500)
  credentialExpiresAt DateTime? @map("credential_expires_at") @db.Timestamptz(6)
  configuredAt        DateTime  @default(now()) @map("configured_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_microsoft_connectors")
}

model EncryptedSecret {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique @db.VarChar(200)
  ciphertext           Bytes
  initializationVector Bytes    @map("initialization_vector")
  authenticationTag    Bytes    @map("authentication_tag")
  legacyReference      String?  @unique @map("legacy_reference") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("encrypted_secrets")
}
