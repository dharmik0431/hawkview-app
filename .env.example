# Microsoft Graph API Credentials (Server-side secrets)
# Configure these in AI Studio Settings -> Environment Variables
MICROSOFT_TENANT_ID=your-microsoft-tenant-id-here
MICROSOFT_CLIENT_ID=your-microsoft-client-id-here
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-here

# HawkView Data Mode: 'mock' or 'microsoft'
HAWKVIEW_DATA_MODE=mock
