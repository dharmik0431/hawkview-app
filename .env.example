# Public URL of the HawkView backend API.
# This is the only data service the browser is allowed to call.
# NEXT_PUBLIC_API_BASE_URL is intentionally unsupported; keep one authority.
# Do not put database passwords, Microsoft secrets, or service-account keys here.
NEXT_PUBLIC_API_URL=https://api.hawkviewapp.com

# Stable public application origin used for confirmation and recovery links.
# Hosted editor/preview origins are never valid production auth destinations.
NEXT_PUBLIC_SITE_URL=https://console.hawkviewapp.com

# Public Supabase browser configuration. The publishable key is intentionally
# safe for browser use. Never put a Supabase secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://lvjqyvrtlkmhseelofda.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only global UI exposure: unset or true shows Risky Users for all tenants.
# Explicit false is the emergency hide; blank/unknown values also hide the UI.
# Independent of backend evaluation/availability; never rename to NEXT_PUBLIC_*.
# Example only: existing deployed false stays unchanged until coordinated release.
HAWKVIEW_IDENTITY_RISK_UI_ENABLED=true
