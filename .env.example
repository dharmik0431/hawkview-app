# Public URL of the HawkView backend API.
# This is the only data service the browser is allowed to call.
# Do not put database passwords, Microsoft secrets, or service-account keys here.
NEXT_PUBLIC_API_URL=https://api.example.hawkview.net

# Public browser configuration for Google Cloud Identity Platform.
# These values identify the app; they are not database credentials or secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hawkview-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hawkview-app
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
